# ==============================================================================
# Custom Handcrafted Domain Blacklist for Pi-hole
# Managed via pihole-updatelists / pihole-cloud-updater
# File location on Pi-hole: /etc/pihole/custom-blacklist.list
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Ad Services & Video Telemetry
# ------------------------------------------------------------------------------
# Google Ad Service delivery
adservice.google.com

# DoubleClick Ad Server and conversion tracker (Google)
ad.doubleclick.net

# YouTube user tracking, video telemetry, and view count beacon
s.youtube.com

# Google Dynamic Ad Insertion (video ad stitching)
dai.google.com

# Google video redirector (tested by superadblocktest)
redirector.googlevideo.com

# ------------------------------------------------------------------------------
# Cryptojacking / Browser Crypto Miners
# ------------------------------------------------------------------------------
# In-browser crypto miner script host
coinimp.com
www.coinimp.com

# ------------------------------------------------------------------------------
